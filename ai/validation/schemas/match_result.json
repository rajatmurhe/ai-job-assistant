{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchResult",
  "type": "object",
  "required": ["overall_score", "sub_scores", "strong_matches", "partial_matches", "missing_skills", "recommendation"],
  "properties": {
    "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
    "sub_scores": {
      "type": "object",
      "required": ["required_skills", "preferred_skills", "experience", "education", "projects", "semantic", "ats_keywords"],
      "properties": {
        "required_skills": {"type": "number"},
        "preferred_skills": {"type": "number"},
        "experience": {"type": "number"},
        "education": {"type": "number"},
        "projects": {"type": "number"},
        "semantic": {"type": "number"},
        "ats_keywords": {"type": "number"}
      }
    },
    "strong_matches": {"type": "array", "items": {"type": "string"}},
    "partial_matches": {"type": "array", "items": {"type": "string"}},
    "missing_skills": {"type": "array", "items": {"type": "string"}},
    "transferable_skills": {"type": "array", "items": {"type": "string"}},
    "missing_ats_keywords": {"type": "array", "items": {"type": "string"}},
    "recommendation": {"type": "string", "enum": ["STRONGLY_APPLY", "APPLY", "APPLY_WITH_CAUTION", "IMPROVE_FIRST", "DO_NOT_APPLY"]},
    "explanation": {"type": ["string", "null"]}
  }
}
